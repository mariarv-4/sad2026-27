# 1) Cargar el módulo ppolicy
dn: cn=module{0},cn=config
changetype: modify
add: olcModuleLoad
olcModuleLoad: ppolicy

# 2) Activar el overlay sobre nuestro directorio e indicar la política por defecto
dn: olcOverlay=ppolicy,olcDatabase={1}mdb,cn=config
changetype: add
objectClass: olcOverlayConfig
objectClass: olcPPolicyConfig
olcOverlay: ppolicy
olcPPolicyDefault: cn=default,ou=politicas,dc=mrv,dc=internal
olcPPolicyHashCleartext: TRUE
